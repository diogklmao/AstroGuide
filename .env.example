# ============================================================
# .env.example — variáveis de ambiente do AstroGuide
#
# Copia este ficheiro para .env e preenche-o. O .env fica fora do
# Git (ver .gitignore) — é lá que as chaves vivem quando se corre
# a aplicação na própria máquina. Num servidor, as mesmas
# variáveis configuram-se no painel do alojamento.
#
# Nenhuma chave vai para o repositório: este ficheiro é o modelo,
# e tem os nomes, nunca os valores.
# ============================================================

# ── AstroGuide AI — fornecedor ──────────────────────────────
# Qual serviço responde ao painel da AstroGuide AI:
#   groq   → a Groq (por omissão, o fornecedor principal)
#   gemini → o Google Gemini (a alternativa)
AI_PROVIDER=groq

# ── AstroGuide AI — Groq (fornecedor principal) ─────────────
# Chave da API Groq. OBRIGATÓRIA com AI_PROVIDER=groq.
# Cria-se em https://console.groq.com/keys — nunca a escrevas
# em código, em JavaScript ou no GitHub.
GROQ_API_KEY=

# O modelo Groq. openai/gpt-oss-120b por omissão; mudar aqui
# prepara a aplicação para outro modelo sem tocar em código.
GROQ_MODEL=openai/gpt-oss-120b

# Endpoint da API Groq (opcional). Por omissão usa-se o endpoint
# público — só preencher para apontar noutro sítio.
#GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Quanto o modelo pensa antes de responder: low, medium ou high
# (opcional). low por omissão — respostas mais rápidas e menos
# tokens de raciocínio a gastar quota.
#GROQ_REASONING_EFFORT=low

# ── AstroGuide AI — Gemini (alternativa) ────────────────────
# Só é preciso com AI_PROVIDER=gemini. Alternativa local: o
# ficheiro .ai_key na raiz do projeto (fora do Git).
#GEMINI_API_KEY=

# ── AstroGuide AI — limites ─────────────────────────────────
# Perguntas por utilizador por dia (opcional). 10 por omissão.
# O limite conta-se no servidor, e o painel mostra a hora a que
# renova.
#LIMITE_PERGUNTAS_DIA=10

# ── Sessões ─────────────────────────────────────────────────
# Chave com que o Flask assina o cookie de sessão (opcional).
# Sem ela, o server.py gera uma e guarda-a no .secret_key.
# Num servidor com vários processos, define-a — sem isto cada
# processo assina à sua maneira e as sessões não passam de um
# para o outro.
#ASTROGUIDE_SECRET_KEY=
