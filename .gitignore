# ============================================================
# .gitignore — AstroGuide
# Ficheiros que nunca devem entrar no repositório.
# ============================================================

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Ambientes virtuais ────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Variáveis de ambiente (segredos) ─────────────────────
# O .env leva as chaves da AstroGuide AI e afins (ver .env.example). O exemplo
# fica de fora da ignorância de propósito — é o modelo que vai para o Git, sem
# valores; todo o resto que comece por .env. fica de fora do Git.
.env
.env.*
!.env.example

# ── Efemérides NASA (ficheiros grandes, descarregados auto) ──
# O sky_engine.py descarrega este ficheiro automaticamente
# na primeira execução — não precisa de estar no git.
de421.bsp
*.bsp

# ── Editores e IDEs ───────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
.cursor/

# ── Sistema operativo ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs e temporários ───────────────────────────────────
*.log
*.tmp
*.swp

# ── Base de dados e chaves locais ────────────────────────
# A base de dados tem contas de utilizador e o que cada um guardou. É um
# ficheiro local, não código: pertence a quem corre a aplicação, e cada
# máquina cria o seu na primeira execução. Se fosse para o repositório,
# publicava os dados de quem já tivesse usado a aplicação.
*.db
*.db-journal

# Chave que assina o cookie de sessão (ver _chave_secreta em server.py).
# Quem a tiver consegue forjar uma sessão iniciada, por isso nunca vai para
# o repositório — é gerada automaticamente na primeira execução.
.secret_key

# Chave da AstroGuide AI (ver py/ia/ai_engine.py).
# É uma chave paga ao pedido: quem a tiver gasta o dinheiro de quem a criou,
# e uma chave publicada num repositório é encontrada por robôs em minutos.
# A chave da Groq (GROQ_API_KEY) vive só em variável de ambiente — no .env,
# que está aqui em cima, ou no painel do alojamento. Este ficheiro é a
# alternativa local da GEMINI_API_KEY, e em qualquer dos casos nunca vai para
# o Git.
.ai_key

# ── Claude ───────────────────────────────────────────────
.claude/